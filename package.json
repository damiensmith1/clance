{
  "name": "clance",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Claude Code, one hotkey away, anywhere on your Mac — a screen-aware menu-bar app with on-device dictation",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build-native.mjs && tsc -p tsconfig.json && mkdir -p dist/popup dist/mainWindow dist/shared dist/dictationHud && cp -r src/popup/. dist/popup/ && cp -r src/mainWindow/. dist/mainWindow/ && cp -r src/shared/. dist/shared/ && cp -r src/dictationHud/. dist/dictationHud/",
    "start": "npm run build && electron .",
    "dev": "npm run build && npm start",
    "package": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac",
    "dev:packaged": "npm run build && sh scripts/dev-packaged.sh",
    "check:design": "node scripts/check-design.mjs"
  },
  "build": {
    "appId": "dev.damiensmith.clance",
    "productName": "Clance",
    "asar": false,
    "files": [
      "dist/**/*",
      "package.json",
      "native/ax/build/Release/ax.node",
      "!**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "packaging/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Clance needs the microphone to transcribe your speech into text on this Mac.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.data",
              "public.content"
            ]
          },
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      },
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "packaging/bin/clance",
          "to": "bin/clance"
        }
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@electron/rebuild": "^4.2.0",
    "@lezer/highlight": "1.2.4",
    "@types/node": "^22.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "material-icon-theme": "5.38.1",
    "typescript": "^7.0.2"
  }
}
