{
  "name": "clance",
  "version": "0.1.0",
  "description": "Hotkey-triggered, screen-aware macOS agent popup built on the Claude Agent SDK",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/popup dist/mainWindow dist/shared && cp -r src/popup/. dist/popup/ && cp -r src/mainWindow/. dist/mainWindow/ && cp -r src/shared/. dist/shared/",
    "start": "npm run build && electron .",
    "dev": "npm run build && npm start",
    "package": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac",
    "dev:packaged": "npm run build && sh scripts/dev-packaged.sh"
  },
  "build": {
    "appId": "dev.damiensmith.clance",
    "productName": "Clance",
    "asar": false,
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
